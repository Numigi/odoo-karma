<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_task_form_view_with_karma_widget" model="ir.ui.view">
        <field name="name">Project Task Form View: Add Karma Widget</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div style="float: right; margin-right: 16px">
                    <widget name="karma"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="project_project_form_view_with_karma_widget" model="ir.ui.view">
        <field name="name">Project Form View: Add Karma Widget</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="before">
                <div style="float: right; margin-right: 16px">
                    <widget name="karma"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
